# Copy to .env and fill in. NEVER commit .env or *.pem files.
# Command prefixes (`|`-separated, 1..n). All prefixes work on all platforms.
NYOKOT_PREFIXES=/|!|?
# Platform bot tokens (an adapter only starts if its token is set).
DISCORD_TOKEN=
STOAT_TOKEN=
STOAT_BASE_URL=https://stoat.example/api
FLUXER_TOKEN=
FLUXER_BASE_URL=https://fluxer.example/api
# GitHub App (read-only: Contents, Issues, Pull requests, Metadata).
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=Neko-Void-Linux
# SQLite. WAL mode is forced by the app.
DATABASE_URL=sqlite:nyokot.db?mode=rwc
# Webhook listener.
WEBHOOK_BIND=0.0.0.0:3000
# Outbound pacing: minimum seconds between messages per channel.
NOTIFY_INTERVAL_SECS=1
