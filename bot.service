# systemd unit for bare-metal runs. Hardened sandbox per SPEC.
[Unit]
Description=Nyokot GitHub notifier bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nyokot
Group=nyokot
WorkingDirectory=/opt/nyokot
EnvironmentFile=/opt/nyokot/.env
ExecStart=/opt/nyokot/nyokot
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
